{
	"name": "spotq-queue-service",
	"version": "1.0.0",
	"description": "",
	"main": "index.js",
	"scripts": {
		"dev": "tsx watch src/server.ts",
		"dev:infisical": "infisical run --env=dev -- pnpm dev",
		"build": "tsc --noEmit && tsup",
		"test": "jest",
		"test:infisical": "infisical run --env=dev -- pnpm test",
		"start": "node dist/server.js",
		"lint": "biome check .",
		"test:watch": "jest --watch",
		"test:cov": "jest --coverage",
		"format": "biome check --write .",
		"prisma:generate": "prisma generate",
		"prisma:migrate": "prisma migrate dev",
		"prisma:studio": "prisma studio",
		"perf:test": "k6 run ./test/load-test.js",
		"prepare": "husky"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "11.20.0",
			"onFail": "download"
		}
	},
	"type": "module",
	"dependencies": {
		"@prisma/adapter-pg": "^7.10.1",
		"@prisma/client": "7.10.1",
		"@socket.io/redis-adapter": "^8.3.0",
		"@spotq-org/circuit-breaker": "^1.0.0",
		"@spotq-org/rabbitmq-client": "^1.0.1",
		"@spotq-org/s2s-core": "^1.0.0",
		"axios": "^1.21.1",
		"bullmq": "^6.7.6",
		"dotenv": "^17.4.2",
		"express": "^5.3.0",
		"firebase-admin": "^14.5.1",
		"inversify": "^8.3.0",
		"ioredis": "^6.0.0",
		"jsonwebtoken": "^9.0.3",
		"pg": "^8.23.1",
		"pino": "^10.4.0",
		"prom-client": "^15.1.3",
		"reflect-metadata": "^0.2.2",
		"socket.io": "^4.8.4",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.8",
		"@swc/core": "^1.16.22",
		"@swc/jest": "^0.2.39",
		"@types/express": "^5.0.6",
		"@types/jest": "^30.0.0",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/node": "^26.6.6",
		"@types/pg": "^8.23.1",
		"@types/supertest": "^7.2.1",
		"husky": "^9.1.7",
		"jest": "^30.5.2",
		"lint-staged": "^17.6.1",
		"prisma": "7.10.1",
		"socket.io-client": "^4.8.4",
		"supertest": "^7.3.2",
		"tsc-alias": "^1.9.10",
		"tsup": "^8.5.1",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2"
	},
	"lint-staged": {
		"*.{ts,js,json}": [
			"biome check --write"
		]
	}
